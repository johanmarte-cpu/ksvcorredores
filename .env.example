# Postgres connection string (Neon/Supabase)
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Auth.js — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Vercel Blob (document storage) — create a Blob store in the Vercel dashboard
# and copy its read-write token here for local development.
BLOB_READ_WRITE_TOKEN=""

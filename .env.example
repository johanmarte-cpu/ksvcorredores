# Postgres connection string (Neon/Supabase)
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Auth.js — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Vercel Blob (document storage) — create a Blob store in the Vercel dashboard
# and copy its read-write token here for local development.
BLOB_READ_WRITE_TOKEN=""

# Resend (client email notifications) — resend.com, requires a verified sending domain
RESEND_API_KEY=""
EMAIL_FROM="KSV Corredores de Seguros <notificaciones@tudominio.com>"

# Random secret shared with Vercel Cron so only it can trigger /api/cron/notifications
CRON_SECRET=""

// Prisma schema — Sistema de Gestión para Corredores de Seguros
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  BROKER // Corredor/ejecutivo
  CUSTOMER_SERVICE
  ACCOUNTING
  READ_ONLY
}

enum ClientType {
  PERSON
  COMPANY
}

enum ThirdPartyType {
  TOMADOR
  ASEGURADO
  BENEFICIARIO
  AFIANZADO
  PROVEEDOR
  EMPLEADO
  APODERADO
}

enum IdentificationType {
  CEDULA
  PASAPORTE
  ID_RESIDENCIA
}

enum Sex {
  F
  M
}

enum CorrespondenceAddress {
  TRABAJO
  CORREO_ELECTRONICO
  RESIDENCIA
}

enum EconomicActivity {
  EMPLEADO_ASALARIADO
  PROPIETARIO_SOCIO
  JUBILADO_PENSIONADO
  INVERSIONISTA_PRESTAMISTA
  INDEPENDIENTE
  ESTUDIANTE
  AMA_DE_CASA
  OTRO
}

enum MonthlyIncomeRange {
  UNDER_20K
  FROM_20K_TO_50K
  FROM_50K_TO_100K
  OVER_100K
}

enum InsuranceBranch {
  PERSONAS
  GENERALES
  FIANZAS
  OTRO
}

enum LineOfBusiness {
  AUTO
  LIFE
  HEALTH
  PROPERTY // Incendio / hogar
  LIABILITY
  OTHER
}

enum QuoteStatus {
  DRAFT
  SENT
  IN_REVIEW
  COMPARED
  CONVERTED
  CANCELLED
}

enum QuoteRequestStatus {
  PENDING
  RESPONDED
  DECLINED
  EXPIRED
}

enum PolicyStatus {
  ACTIVE
  PENDING
  EXPIRED
  CANCELLED
  RENEWED
}

enum PaymentFrequency {
  SINGLE
  MONTHLY
  QUARTERLY
  SEMIANNUAL
  ANNUAL
}

enum RenewalType {
  AUTOMATIC
  MANUAL
}

enum RenewalStatus {
  PENDING
  IN_PROGRESS
  OFFERED
  RENEWED
  LAPSED
  DECLINED
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum ClaimStatus {
  OPEN
  IN_REVIEW
  WITH_INSURER
  APPROVED
  REJECTED
  PAID
  CLOSED
}

enum ClaimEventType {
  COMMENT
  STATUS_CHANGE
  INSURER_FOLLOWUP
  DOCUMENT_ADDED
}

enum CommissionStatus {
  EXPECTED
  RECEIVED
  PARTIAL
  DISPUTED
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// ─────────────────────────────────────────────────────────────
// Users & auth
// ─────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(BROKER)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignedClients   Client[]              @relation("ClientAssignedTo")
  clientNotes       ClientNote[]
  quotesRequested   Quote[]               @relation("QuoteRequestedBy")
  claimEvents       ClaimEvent[]
  tasksAssigned     Task[]                @relation("TaskAssignedTo")
  tasksCreated      Task[]                @relation("TaskCreatedBy")
  notifications     Notification[]
  auditLogs         AuditLog[]
  uploadedDocuments ClientDocument[]
  knowledgeForms    ClientKnowledgeForm[]

  @@map("users")
}

// ─────────────────────────────────────────────────────────────
// Clients
// ─────────────────────────────────────────────────────────────

model Client {
  id           String     @id @default(cuid())
  type         ClientType
  firstName    String? // personas físicas
  lastName     String?
  companyName  String? // empresas
  taxId        String     @unique // Cédula/RNC
  email        String?
  phone        String?
  address      String?
  city         String?
  assignedToId String?
  assignedTo   User?      @relation("ClientAssignedTo", fields: [assignedToId], references: [id])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  contacts      ClientContact[]
  documents     ClientDocument[]
  notes         ClientNote[]
  quotes        Quote[]
  policies      Policy[]
  knowledgeForm ClientKnowledgeForm?

  @@map("clients")
}

model ClientContact {
  id       String  @id @default(cuid())
  clientId String
  client   Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name     String
  position String?
  email    String?
  phone    String?
  notes    String?

  @@map("client_contacts")
}

model ClientDocument {
  id           String   @id @default(cuid())
  clientId     String
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name         String
  fileUrl      String
  fileType     String?
  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  @@map("client_documents")
}

model ClientNote {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id])
  content   String
  createdAt DateTime @default(now())

  @@map("client_notes")
}

// Formulario de Conocimiento (KYC) — uno por cliente, requerido para
// cumplimiento de la Ley 155-17 contra el Lavado de Activos.
model ClientKnowledgeForm {
  id       String @id @default(cuid())
  clientId String @unique
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  thirdPartyTypes ThirdPartyType[]
  branch          String?

  idType           IdentificationType?
  idNumber         String?
  idExpirationDate DateTime?
  sex              Sex?
  birthDate        DateTime?
  birthCity        String?
  birthProvince    String?
  nationality      String?
  profession       String?
  occupation       String?
  employer         String?
  employerAddress  String?
  employerCity     String?
  employerProvince String?
  employerPhone    String?

  residenceCity         String?
  residenceProvince     String?
  residenceCountry      String?
  residencePhone        String?
  residenceCell         String?
  residenceAddress      String?
  sector                String?
  correspondenceAddress CorrespondenceAddress?

  economicActivity      EconomicActivity?
  economicActivityOther String?

  monthlyIncomeRange     MonthlyIncomeRange?
  otherIncomeAmount      Decimal?            @db.Decimal(12, 2)
  otherIncomeDescription String?

  hasManagedPublicFunds       Boolean?
  hasManagedPublicFundsDetail String?
  hasHeldPublicOffice         Boolean?
  hasHeldPublicOfficeDetail   String?
  isPep                       Boolean?
  isPepDetail                 String?
  relativeIsPep               Boolean?
  relativeIsPepDetail         String?

  insuranceBranch      InsuranceBranch?
  insuranceBranchOther String?

  verificationDate DateTime?
  verifierCode     String?
  completedById    String?
  completedBy      User?     @relation(fields: [completedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("client_knowledge_forms")
}

// ─────────────────────────────────────────────────────────────
// Insurers (catálogo configurable)
// ─────────────────────────────────────────────────────────────

model Insurer {
  id        String   @id @default(cuid())
  name      String   @unique
  taxId     String?
  phone     String?
  email     String?
  website   String?
  address   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products        InsurerProduct[]
  contacts        InsurerContact[]
  commissionRates InsurerCommissionRate[]
  documents       InsurerDocument[]
  quoteRequests   QuoteRequest[]
  policies        Policy[]

  @@map("insurers")
}

model InsurerProduct {
  id             String         @id @default(cuid())
  insurerId      String
  insurer        Insurer        @relation(fields: [insurerId], references: [id], onDelete: Cascade)
  name           String
  lineOfBusiness LineOfBusiness
  description    String?
  active         Boolean        @default(true)

  commissionRates InsurerCommissionRate[]
  quoteRequests   QuoteRequest[]
  policies        Policy[]

  @@unique([insurerId, name])
  @@map("insurer_products")
}

model InsurerContact {
  id        String  @id @default(cuid())
  insurerId String
  insurer   Insurer @relation(fields: [insurerId], references: [id], onDelete: Cascade)
  name      String
  role      String?
  email     String?
  phone     String?

  @@map("insurer_contacts")
}

model InsurerCommissionRate {
  id            String          @id @default(cuid())
  insurerId     String
  insurer       Insurer         @relation(fields: [insurerId], references: [id], onDelete: Cascade)
  productId     String?
  product       InsurerProduct? @relation(fields: [productId], references: [id], onDelete: Cascade)
  percentage    Decimal         @db.Decimal(5, 2)
  effectiveFrom DateTime
  effectiveTo   DateTime?
  notes         String?

  @@map("insurer_commission_rates")
}

model InsurerDocument {
  id        String   @id @default(cuid())
  insurerId String
  insurer   Insurer  @relation(fields: [insurerId], references: [id], onDelete: Cascade)
  name      String
  fileUrl   String
  category  String?
  createdAt DateTime @default(now())

  @@map("insurer_documents")
}

// ─────────────────────────────────────────────────────────────
// Quotes
// ─────────────────────────────────────────────────────────────

model Quote {
  id             String         @id @default(cuid())
  clientId       String
  client         Client         @relation(fields: [clientId], references: [id])
  lineOfBusiness LineOfBusiness
  requestedById  String?
  requestedBy    User?          @relation("QuoteRequestedBy", fields: [requestedById], references: [id])
  status         QuoteStatus    @default(DRAFT)
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  requests        QuoteRequest[]
  documents       QuoteDocument[]
  convertedPolicy Policy?

  @@map("quotes")
}

model QuoteRequest {
  id          String             @id @default(cuid())
  quoteId     String
  quote       Quote              @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  insurerId   String
  insurer     Insurer            @relation(fields: [insurerId], references: [id])
  productId   String?
  product     InsurerProduct?    @relation(fields: [productId], references: [id])
  status      QuoteRequestStatus @default(PENDING)
  sentAt      DateTime?
  respondedAt DateTime?

  option QuoteOption?

  @@map("quote_requests")
}

model QuoteOption {
  id              String       @id @default(cuid())
  quoteRequestId  String       @unique
  quoteRequest    QuoteRequest @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  premium         Decimal      @db.Decimal(12, 2)
  coverageSummary String?
  deductible      Decimal?     @db.Decimal(12, 2)
  termMonths      Int          @default(12)
  isSelected      Boolean      @default(false)
  notes           String?
  createdAt       DateTime     @default(now())

  @@map("quote_options")
}

model QuoteDocument {
  id        String   @id @default(cuid())
  quoteId   String
  quote     Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  name      String
  fileUrl   String
  createdAt DateTime @default(now())

  @@map("quote_documents")
}

// ─────────────────────────────────────────────────────────────
// Policies
// ─────────────────────────────────────────────────────────────

model Policy {
  id                   String           @id @default(cuid())
  policyNumber         String           @unique
  clientId             String
  client               Client           @relation(fields: [clientId], references: [id])
  insurerId            String
  insurer              Insurer          @relation(fields: [insurerId], references: [id])
  productId            String
  product              InsurerProduct   @relation(fields: [productId], references: [id])
  quoteId              String?          @unique
  quote                Quote?           @relation(fields: [quoteId], references: [id])
  premium              Decimal          @db.Decimal(12, 2)
  itbisAmount          Decimal          @db.Decimal(12, 2)
  totalAmount          Decimal          @db.Decimal(12, 2)
  commissionPercentage Decimal          @db.Decimal(5, 2)
  commissionAmount     Decimal          @db.Decimal(12, 2)
  paymentFrequency     PaymentFrequency @default(ANNUAL)
  startDate            DateTime
  endDate              DateTime
  status               PolicyStatus     @default(ACTIVE)
  renewalType          RenewalType      @default(MANUAL)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  documents   PolicyDocument[]
  payments    PolicyPayment[]
  commissions PolicyCommission[]
  renewals    PolicyRenewal[]    @relation("RenewalOfPolicy")
  renewedInto PolicyRenewal[]    @relation("RenewalNewPolicy")
  claims      Claim[]

  @@index([endDate])
  @@map("policies")
}

model PolicyDocument {
  id        String   @id @default(cuid())
  policyId  String
  policy    Policy   @relation(fields: [policyId], references: [id], onDelete: Cascade)
  name      String
  fileUrl   String
  category  String?
  createdAt DateTime @default(now())

  @@map("policy_documents")
}

model PolicyPayment {
  id        String        @id @default(cuid())
  policyId  String
  policy    Policy        @relation(fields: [policyId], references: [id], onDelete: Cascade)
  amount    Decimal       @db.Decimal(12, 2)
  dueDate   DateTime
  paidDate  DateTime?
  status    PaymentStatus @default(PENDING)
  method    String?
  createdAt DateTime      @default(now())

  @@map("policy_payments")
}

model PolicyCommission {
  id             String           @id @default(cuid())
  policyId       String
  policy         Policy           @relation(fields: [policyId], references: [id], onDelete: Cascade)
  period         String // e.g. "2026-09"
  expectedAmount Decimal          @db.Decimal(12, 2)
  receivedAmount Decimal?         @db.Decimal(12, 2)
  receivedDate   DateTime?
  status         CommissionStatus @default(EXPECTED)
  notes          String?
  createdAt      DateTime         @default(now())

  @@map("policy_commissions")
}

model PolicyRenewal {
  id            String        @id @default(cuid())
  policyId      String
  policy        Policy        @relation("RenewalOfPolicy", fields: [policyId], references: [id], onDelete: Cascade)
  dueDate       DateTime
  status        RenewalStatus @default(PENDING)
  alert60SentAt DateTime?
  alert30SentAt DateTime?
  alert15SentAt DateTime?
  newPolicyId   String?
  newPolicy     Policy?       @relation("RenewalNewPolicy", fields: [newPolicyId], references: [id])
  taskId        String?       @unique
  task          Task?         @relation(fields: [taskId], references: [id])
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@map("policy_renewals")
}

// ─────────────────────────────────────────────────────────────
// Claims
// ─────────────────────────────────────────────────────────────

model Claim {
  id           String      @id @default(cuid())
  caseNumber   String      @unique
  policyId     String
  policy       Policy      @relation(fields: [policyId], references: [id])
  incidentDate DateTime
  claimType    String
  status       ClaimStatus @default(OPEN)
  description  String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  documents ClaimDocument[]
  events    ClaimEvent[]

  @@map("claims")
}

model ClaimDocument {
  id        String   @id @default(cuid())
  claimId   String
  claim     Claim    @relation(fields: [claimId], references: [id], onDelete: Cascade)
  name      String
  fileUrl   String
  createdAt DateTime @default(now())

  @@map("claim_documents")
}

model ClaimEvent {
  id        String         @id @default(cuid())
  claimId   String
  claim     Claim          @relation(fields: [claimId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?          @relation(fields: [authorId], references: [id])
  type      ClaimEventType @default(COMMENT)
  content   String
  createdAt DateTime       @default(now())

  @@map("claim_events")
}

// ─────────────────────────────────────────────────────────────
// Tasks, notifications, audit
// ─────────────────────────────────────────────────────────────

model Task {
  id           String       @id @default(cuid())
  title        String
  description  String?
  dueDate      DateTime?
  assignedToId String?
  assignedTo   User?        @relation("TaskAssignedTo", fields: [assignedToId], references: [id])
  createdById  String?
  createdBy    User?        @relation("TaskCreatedBy", fields: [createdById], references: [id])
  status       TaskStatus   @default(PENDING)
  priority     TaskPriority @default(MEDIUM)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  renewal PolicyRenewal?

  @@map("tasks")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@map("audit_logs")
}
